# Townplay API environment. Copy to apps/api/.env and fill in real values.
# Never commit apps/api/.env (it is gitignored). Empty = not set (the default is used).
# Vars marked REQUIRED must be set; the api refuses to start and lists what is missing.

# ---------- app ----------
# development | test | production. Production enforces Resend + live Razorpay below.
NODE_ENV=development
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Shown at /health (e.g. the git commit on Render). Default: dev
APP_VERSION=

# ---------- database ----------
# REQUIRED. MongoDB replica set (bookings use transactions).
# Local Docker:  mongodb://localhost:27017/townplay?replicaSet=rs0
# Atlas:         mongodb+srv://<user>:<password>@<cluster>.mongodb.net/townplay?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/townplay?replicaSet=rs0

# ---------- web + auth ----------
# REQUIRED. Origin of the web app (CORS + trusted auth origin). Prod: https://<your-site>
WEB_ORIGIN=http://localhost:3000
# Public URL where /v1/auth/* is reached. Leave empty to use WEB_ORIGIN (the web app proxies /v1).
AUTH_URL=
# REQUIRED. 32+ random characters. Generate: openssl rand -hex 32
AUTH_SECRET=
# Google sign-in (optional; set both or neither). Google Cloud Console → OAuth client (Web).
# Authorised redirect URI: <WEB_ORIGIN>/v1/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# This email becomes admin when you run: pnpm --filter @townplay/api seed
SEED_ADMIN_EMAIL=

# ---------- email ----------
# Resend API key. Empty = emails (incl. sign-in OTP codes) are printed in the api log. Required in production.
RESEND_API_KEY=
# Sender, on a domain verified in Resend. Default: Townplay <no-reply@townplay.local>
EMAIL_FROM=

# ---------- payments (Razorpay) ----------
# fake = test-mode buttons, no Razorpay account needed. Production must be razorpay.
PAYMENTS_PROVIDER=fake
# Razorpay Dashboard → Account & Settings → API Keys (use rzp_test_… keys first).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard → Webhooks. URL: <api origin>/v1/webhooks/razorpay
# Events: payment.captured, payment.failed, refund.processed, refund.failed
RAZORPAY_WEBHOOK_SECRET=
# manual = admin payouts report (pay venues yourself); route = automatic Razorpay Route transfers.
PAYOUTS_MODE=manual
# Default convenience fee until an admin saves one in /admin/settings.
# Examples: flat:1000 (₹10) · percent:2 · flat:500,percent:1.5   (flat is in paise)
CONVENIENCE_FEE_CONFIG=

# ---------- images ----------
# Cloudinary Dashboard → API Environment variable: cloudinary://<api_key>:<api_secret>@<cloud_name>
# Empty = photo uploads are turned off.
CLOUDINARY_URL=

# ---------- web push (owner booking alerts) ----------
# Generate once: npx web-push generate-vapid-keys. Empty = push is off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services. Default: mailto:support@townplay.local
VAPID_SUBJECT=

# ---------- operations ----------
# Sentry DSN for error tracking (optional).
SENTRY_DSN=
# Proxy hops in front of the api, for correct client IPs. Local: 0 · Render + Vercel rewrite: 2
TRUST_PROXY=0
# Requests per minute per IP across /v1. Default: 300
RATE_LIMIT_MAX=
# Sign-in OTP emails per 15 minutes per IP. Default: 10
OTP_RATE_LIMIT_MAX=
