{
  "name": "townplay-server",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint && prettier --check .",
    "format": "prettier --write .",
    "test": "turbo run test",
    "prepare": "husky"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "prettier": "@townplay/config/prettier",
  "devDependencies": {
    "@townplay/config": "workspace:*",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.5",
    "typescript": "~5.9.3"
  }
}
